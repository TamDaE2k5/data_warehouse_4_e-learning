# ==============================================================================
# TỆP MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION TEMPLATE)
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép file này thành '.env' trên máy của bạn: cp .env.example .env
# 2. Điều chỉnh mật khẩu và cổng kết nối nếu cần thiết.
# 3. File '.env' thực tế đã được chặn trong '.gitignore' nên sẽ không bị đẩy lên GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH POSTGRESQL (CƠ SỞ DỮ LIỆU TÁC NGHIỆP VÀ STAGING)
# ------------------------------------------------------------------------------
# Cổng kết nối ánh xạ ra máy host (tránh xung đột với cổng 5432 mặc định nếu máy đã cài Postgres)
PG_PORT=55432

# Mật khẩu tài khoản quản trị tối cao (Superuser 'learning')
PG_PASSWORD=local_learning_demo

# Mật khẩu tài khoản chỉ đọc 'learning_reader' (Chuyên dùng để trích xuất dữ liệu an toàn từ OLTP)
PG_READER_PASSWORD=local_reader_demo

# Mật khẩu tài khoản trung chuyển 'learning_stage' (Toàn quyền trên dwh_staging, cấm vào OLTP)
PG_STAGE_PASSWORD=local_staging_demo

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH CLICKHOUSE (KHO DỮ LIỆU ĐA CHIỀU OLAP)
# ------------------------------------------------------------------------------
# Cổng giao thức HTTP của ClickHouse Server ánh xạ ra máy host
CH_PORT=58123

# Mật khẩu tài khoản phân tích ClickHouse (User 'learning')
CH_PASSWORD=local_learning_demo

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH GIAO DIỆN PHÂN TÍCH (STREAMLIT DASHBOARD PORTAL)
# ------------------------------------------------------------------------------
# Cổng truy cập ứng dụng Web Dashboard
PORTAL_PORT=8501
